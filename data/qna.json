      "_id": "blurb:intro",
      "type": "blurb",
      "text": "",
      "label": "",
      "paragraphs": [
        "Hello! I'm [Arun](https://www.linkedin.com/in/arunsjohnson/)."
      ],
      "createdAt": "2026-09-21T00:53:02.264272+00:00",
      "updatedAt": "2026-09-21T00:53:02.264272+00:00"
